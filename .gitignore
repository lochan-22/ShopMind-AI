# ==============================================================================
# ShopMind AI - Root .gitignore
# ==============================================================================

# Operating System & Editors
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Environment & Secrets (NEVER COMMIT)
.env
.env.*
!.env.example
*.pem
*.key

# Python & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
ENV/
.pytest_cache/
.coverage
htmlcov/
*.egg-info/

# Node & Frontend Build Artifacts
node_modules/
dist/
dist-ssr/
.dist/
frontend/dist/
frontend/dist-ssr/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Databases
*.db
*.sqlite
*.sqlite3

# Temporary & Scratch Files
scratch/
scratch_*.py
scratch_*.js
*.log
logs/

